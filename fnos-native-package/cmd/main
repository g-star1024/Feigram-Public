#!/bin/bash

APP_HOME="${TRIM_APPDEST}"
NODE_BIN="${APP_HOME}/bin/node"
DOWNLOADER_BIN="${APP_HOME}/bin/feigram-downloader"
SERVER_DIR="${APP_HOME}/server"
DATA_HOME="/${TRIM_APPDEST_VOL}/@appshare/feigrampub"
PID_FILE="${DATA_HOME}/feigram.pid"
DOWNLOADER_PID_FILE="${DATA_HOME}/feigram-downloader.pid"
VERSION_FILE="${DATA_HOME}/feigram.version"
LOG_FILE="${DATA_HOME}/feigram.log"
DOWNLOADER_LOG_FILE="${DATA_HOME}/feigram-downloader.log"
PORT="${wizard_app_port:-3088}"
DOWNLOADER_PORT="${FEIGRAM_DOWNLOADER_PORT:-3090}"

export APP_PORT="$PORT"
export APP_PASSWORD="${wizard_app_password}"
export PUBLIC_BASE_URL="${wizard_public_base_url:-http://127.0.0.1:${PORT}}"
export TELEGRAM_API_ID="${wizard_telegram_api_id}"
export TELEGRAM_API_HASH="${wizard_telegram_api_hash}"
export DATA_DIR="${DATA_HOME}/data"
export DOWNLOAD_DIR="${DATA_HOME}/data/downloads"
export LOG_FILE="$LOG_FILE"
export FEIGRAM_DOWNLOADER_PORT="$DOWNLOADER_PORT"
export FEIGRAM_DOWNLOADER_DATA="${DATA_HOME}/data/downloader"
export FEIGRAM_DOWNLOADER_URL="http://127.0.0.1:${DOWNLOADER_PORT}"
export FEIGRAM_DOWNLOADER_LOG="$DOWNLOADER_LOG_FILE"
export FEIGRAM_DOWNLOADER_SECRET_FILE="${DATA_HOME}/data/app-secret"
export APP_EDITION="Feigram 2.0 fnOS Client Edition"
export APP_VERSION="2.6.15"
export APP_CHANGELOG="DC 迁移修复：FILE_MIGRATE 空格括号形态此前不被识别，迁移指令被当普通瞬态、任务在错误 DC 与文件所在 DC 间打转；现两种形态均解析并即切目标 DC 续传（带预算防循环）。另：AUTH_BYTES_INVALID 转瞬态可读文案；会话分页中间页失败重试一次并返回已拉取部分"
export NODE_ENV="production"

is_running() {
    if [ -f "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE")"
        if [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1; then
            return 0
        fi
    fi
    return 1
}

stop_running() {
    if is_running; then
        pid="$(cat "$PID_FILE")"
        kill "$pid" >/dev/null 2>&1 || true
        for _ in 1 2 3 4 5; do
            if ! kill -0 "$pid" >/dev/null 2>&1; then
                break
            fi
            sleep 1
        done
        if kill -0 "$pid" >/dev/null 2>&1; then
            kill -9 "$pid" >/dev/null 2>&1 || true
        fi
    fi
    rm -f "$PID_FILE"
    if [ -f "$DOWNLOADER_PID_FILE" ]; then
        downloader_pid="$(cat "$DOWNLOADER_PID_FILE")"
        if [ -n "$downloader_pid" ] && kill -0 "$downloader_pid" >/dev/null 2>&1; then
            kill "$downloader_pid" >/dev/null 2>&1 || true
            sleep 1
            if kill -0 "$downloader_pid" >/dev/null 2>&1; then
                kill -9 "$downloader_pid" >/dev/null 2>&1 || true
            fi
        fi
        rm -f "$DOWNLOADER_PID_FILE"
    fi
    if command -v pgrep >/dev/null 2>&1; then
        pattern="${APP_HOME}/bin/node.*src/index.js|${SERVER_DIR}/src/index.js"
        for old_pid in $(pgrep -f "$pattern" 2>/dev/null || true); do
            if [ -n "$old_pid" ] && [ "$old_pid" != "$$" ]; then
                kill "$old_pid" >/dev/null 2>&1 || true
            fi
        done
        sleep 1
        for old_pid in $(pgrep -f "$pattern" 2>/dev/null || true); do
            if [ -n "$old_pid" ] && [ "$old_pid" != "$$" ]; then
                kill -9 "$old_pid" >/dev/null 2>&1 || true
            fi
        done
        downloader_pattern="${APP_HOME}/bin/feigram-downloader|feigram-downloader"
        for old_pid in $(pgrep -f "$downloader_pattern" 2>/dev/null || true); do
            if [ -n "$old_pid" ] && [ "$old_pid" != "$$" ]; then
                kill "$old_pid" >/dev/null 2>&1 || true
            fi
        done
    fi
}

case "$1" in
start)
    mkdir -p "$DATA_HOME" "$DATA_DIR" "$DOWNLOAD_DIR" "$FEIGRAM_DOWNLOADER_DATA"
    INTERNAL_TOKEN_FILE="${DATA_HOME}/feigram-internal-token"
    if [ ! -f "$INTERNAL_TOKEN_FILE" ]; then
        if command -v od >/dev/null 2>&1; then
            od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$INTERNAL_TOKEN_FILE"
        elif command -v sha256sum >/dev/null 2>&1; then
            date +%s%N | sha256sum | awk '{print $1}' > "$INTERNAL_TOKEN_FILE"
        else
            date +%s%N > "$INTERNAL_TOKEN_FILE"
        fi
        chmod 600 "$INTERNAL_TOKEN_FILE" >/dev/null 2>&1 || true
    fi
    export FEIGRAM_INTERNAL_TOKEN="$(cat "$INTERNAL_TOKEN_FILE" 2>/dev/null)"
    chmod +x "$NODE_BIN"
    if is_running; then
        running_version=""
        if [ -f "$VERSION_FILE" ]; then
            running_version="$(cat "$VERSION_FILE")"
        fi
        if [ "$running_version" = "$APP_VERSION" ]; then
            exit 0
        fi
        {
            echo "==== $(date '+%Y-%m-%d %H:%M:%S') Feigram upgrade restart ===="
            echo "From: ${running_version:-unknown}"
            echo "To: ${APP_VERSION}"
        } >> "$LOG_FILE"
        stop_running
    fi
    cd "$SERVER_DIR" || exit 1
    {
        echo "==== $(date '+%Y-%m-%d %H:%M:%S') Feigram start ===="
        echo "Edition: ${APP_EDITION}"
        echo "Version: ${APP_VERSION}"
        echo "Port: ${APP_PORT}"
        echo "Data: ${DATA_DIR}"
        echo "Downloads: ${DOWNLOAD_DIR}"
        echo "Go downloader: ${FEIGRAM_DOWNLOADER_URL}"
    } >> "$LOG_FILE"
    nohup "$NODE_BIN" src/index.js >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    sleep 2
    if is_running; then
        if [ -x "$DOWNLOADER_BIN" ]; then
            chmod +x "$DOWNLOADER_BIN"
            sleep 1
            nohup "$DOWNLOADER_BIN" >> "$DOWNLOADER_LOG_FILE" 2>&1 &
            echo $! > "$DOWNLOADER_PID_FILE"
        else
            echo "Go downloader binary missing: $DOWNLOADER_BIN" >> "$LOG_FILE"
        fi
        echo "$APP_VERSION" > "$VERSION_FILE"
        exit 0
    fi
    tail -80 "$LOG_FILE"
    exit 1
    ;;
stop)
    stop_running
    exit 0
    ;;
status)
    if is_running; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
